# ---- your site / brand ----
SEOFORGE_SITE_URL=https://example.com
SEOFORGE_BRAND_NAME=Brand
SEOFORGE_BRAND_TAGLINE=
SEOFORGE_SAME_AS=

# ---- crawler ----
SEOFORGE_MAX_PAGES=500
SEOFORGE_MAX_DEPTH=8
SEOFORGE_MAX_CONCURRENCY=8
SEOFORGE_RESPECT_ROBOTS=true
# SSRF safety: allow fetching private/loopback addresses (local development only;
# cannot be enabled from the MCP tools or dashboard - leave empty in production)
SEOFORGE_ALLOW_PRIVATE_FETCH=

# ---- Google Search Console ----
# OAuth client secret JSON (create at console.cloud.google.com > APIs > Search Console API > OAuth client > Desktop app)
GSC_CREDENTIALS_PATH=data/gsc_client_secret.json
GSC_PROPERTY=
GSC_DAYS=90

# ---- SERP / keyword data ----
SEOFORGE_SERP_METHOD=auto
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPDEV_API_KEY=

# ---- OpenSEO (YC) passthrough (optional; their MCP can also be attached directly) ----
OPENSEO_URL=
OPENSEO_API_KEY=

# ---- browser agent ----
SEOFORGE_BROWSER_AGENT=browseruse
SEOFORGE_HEADLESS=true
SEOFORGE_CONFIRM_SUBMISSIONS=true

# ---- AI content generation (content_gen.py) ----
# All optional: when no key is set, an offline structural writer is used instead.
OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=gpt-4o-mini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- publisher.py targets (all optional) ----
# WordPress REST publishing
WP_URL=
WP_USER=
WP_APP_PASSWORD=
# Local repo deploy: path to a Next.js/Astro public/ dir for llms.txt + robots.txt
LOCAL_REPO_PUBLIC_DIR=
